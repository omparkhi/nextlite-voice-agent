# NextLite Pipecat Telephony Worker
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# NextLite Control Plane API
NEXTLITE_API_URL=http://localhost:3001
WORKER_API_SECRET=dev-worker-api-secret
REDIS_URL=redis://127.0.0.1:6379

# Plivo Telephony Credentials
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_PHONE_NUMBER=+91XXXXXXXXXX

# Sarvam AI API (Realtime STT / TTS / LLM)
SARVAM_API_KEY=your-sarvam-api-key

# OpenRouter & Fast Conversational LLM Settings
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_TITLE=NextLite Voice Agent
CONVERSATIONAL_LLM_MODEL=google/gemma-4-26b-a4b-it
CONVERSATIONAL_LLM_PROVIDER=sarvam

# Optional Audio Debugging
PIPECAT_AUDIO_DEBUG=false
