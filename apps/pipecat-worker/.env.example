# NextLite Pipecat Telephony Worker (Phase 1 POC)
# Copy to .env and configure as needed for manual Plivo testing

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Optional Plivo credentials for authentication/signature validation
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Optional shared secret key for WebSocket endpoint protection during POC
POC_SECRET_KEY=
