# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextlite_voice

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Frontend
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=your-email@example.com

# Logging
LOG_LEVEL=debug

# Development Seed (only used by db:seed script)
DEV_ADMIN_EMAIL=admin@nextlite.local
DEV_ADMIN_PASSWORD=changeme123
DEV_ADMIN_NAME=NextLite Admin

# Embedding Provider
EMBEDDING_PROVIDER=nvidia
NVIDIA_API_KEY=your-nvidia-api-key
GEMINI_API_KEY=your-gemini-api-key

# LLM
SARVAM_API_KEY=your-sarvam-api-key

# Object Storage (Backblaze B2 — Phase 3 MVP)
STORAGE_PROVIDER=b2
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-b2-bucket-name

# Telephony Provider
TELEPHONY_PROVIDER=exotel

# Exotel (required for real calls)
EXOTEL_ACCOUNT_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_CALLER_ID=0XXXXXXXXXX
EXOTEL_BASE_URL=https://api.in.exotel.com
